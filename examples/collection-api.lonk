let first_even = fn(values: [int]) -> {
    value?: int;
} {
    for value in values {
        if value % 2 == 0 {
            return {
                value = value;
            };
        };
    };
    return {};
};
let values = [
    1,
    2,
    3,
    4,
];
let before = values;
values.push(5);
let trimmed = object.remove({
    name = "example";
    temporary = 1 / 0;
}, "temporary");
{
    before = before;
    after = values;
    middle = values[1:4];
    squares = values.map(fn(value: int) value * value);
    even = values.filter(fn(value: int) value % 2 == 0);
    first_even = first_even(values);
    replaced = values.splice(1, 3, [
        10,
        20,
    ]);
    joined = [
        "compiler",
        "library",
        "editor",
    ].join(" -> ");
    removed = match trimmed {
        {
            name: str;
            ...;
        } => trimmed.name;
        else => "missing";
    };
}
